# Absolute path to your Obsidian vault on the host machine
OBSIDIAN_VAULT_PATH=/path/to/your/vault

# Host port to expose obsidian-mcp HTTP server on
MCP_PORT=8080

# Optional Bearer API key for HTTP authentication (leave empty for no auth)
OBSIDIAN_MCP_API_KEY=

# Host user/group IDs so created markdown files match your Linux user permissions
PUID=1000
PGID=1000

# Timezone (used for Daily Notes date resolution)
TZ=Asia/Tashkent

